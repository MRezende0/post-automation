# Gemini API — geração de variações
GEMINI_API_KEY=

# Instagram Graph API (Meta for Developers)
# Long-lived user access token (60 dias, renovável automaticamente)
IG_ACCESS_TOKEN=
# ID da conta Instagram Business (não confundir com numeric ID público)
IG_BUSINESS_ACCOUNT_ID=
# App credentials pra refresh de token
META_APP_ID=
META_APP_SECRET=

# LinkedIn API
# Access token OAuth (60 dias)
LINKEDIN_ACCESS_TOKEN=
# Refresh token pra renovar
LINKEDIN_REFRESH_TOKEN=
# URN da pessoa (urn:li:person:XXX) ou organização (urn:li:organization:XXX)
LINKEDIN_AUTHOR_URN=
# App credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Telegram Bot — aprovação
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Flags runtime
# DRY_RUN=true             → não chama APIs externas, mocka tudo
# PUBLISH_TEST=true        → publica 1 post hardcoded em sandbox
# SKIP_APPROVAL=true       → pula Telegram, publica direto top-1
# CHANNELS=instagram,linkedin  → canais a publicar (default: instagram)
# MAX_REGEN=3              → máximo de regenerações via botão "Regenerar" do Telegram
# HOLIDAY_AWARE=false      → desliga posts temáticos por feriado (default: ligado)
# HOLIDAY_WINDOW_DAYS=7    → antecedência pra detectar feriado próximo
# METRICS_WINDOW_DAYS=30   → janela de coleta de engajamento no relatório semanal
