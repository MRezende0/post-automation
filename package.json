{
  "name": "post-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automação de postagens Instagram + LinkedIn via GitHub Actions, geração com Gemini API, aprovação via Telegram.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "resolve": "node src/resolve.js",
    "dry-run": "DRY_RUN=true node src/index.js",
    "publish:test": "PUBLISH_TEST=true node src/index.js",
    "refresh-tokens": "node src/refresh-tokens.js",
    "metrics": "node src/metrics.js",
    "repurpose": "node src/repurpose.js",
    "reel": "node src/reel.js",
    "engage": "node src/engage.js",
    "reflect": "node src/reflect.js",
    "backfill": "node scripts/backfill-supabase.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "libsodium-wrappers": "^0.7.15",
    "node-telegram-bot-api": "^0.66.0",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
